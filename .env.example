# Copy this file to .env before running Docker Compose.
# Keep the PostgreSQL values and credentials embedded in EAV_DATABASE_URL in
# sync when changing them.
POSTGRES_DB=asset_validator
POSTGRES_USER=asset_validator
POSTGRES_PASSWORD=change-me-for-non-local-use
EAV_DATABASE_URL=postgresql+psycopg://asset_validator:change-me-for-non-local-use@postgres:5432/asset_validator

BACKEND_PORT=8000
FRONTEND_PORT=3000
BIND_ADDRESS=127.0.0.1
EAV_MAX_UPLOAD_MB=10
EAV_DOCS_ENABLED=true

# Used by the Vite development server. The production container uses /api/v1
# on the same origin and proxies it to the backend.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8000

# JSON array of origins accepted by the API during local development.
EAV_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional bearer-token authentication. Empty keeps the API open with
# per-browser-session scoping. Set one or more comma-separated shared tokens
# to require "Authorization: Bearer <token>" on every data route; runs are
# then isolated per token. Tokens are shared secrets, not user accounts.
EAV_API_TOKENS=
